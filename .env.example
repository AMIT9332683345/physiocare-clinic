# Copy to .env.local and fill in. Never commit the real values.

# Atlas connection string. Without it the site runs on the demo data in data/.
MONGODB_URI=mongodb://127.0.0.1:27017
# Optional: database name if it is not the one in the URI path.
# MONGODB_DBNAME=physiocare

# Admin panel session signing secret — REQUIRED in production (the build refuses a
# working login without it). Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ADMIN_SESSION_SECRET=

# Your live domain. Used for share-link previews and sitemap.xml. The same value can
# be edited later in /admin/clinic without redeploying.
SITE_URL=https://physiocare-clinic-three.vercel.app

# Optional: read-only token for GET /api/inbox?token=… (the panel at /admin/inbox
# does not need this).
# ADMIN_TOKEN=
